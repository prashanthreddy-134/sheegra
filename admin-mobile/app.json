{
  "expo": {
    "name": "Sheegra Admin",
    "slug": "sheegra-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#101913" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.freshstore.admin" },
    "android": { "package": "com.freshstore.admin", "permissions": ["NOTIFICATIONS"] },
    "plugins": [
      ["expo-notifications", { "icon": "./assets/icon.png", "color": "#1B7A43" }],
      ["expo-image-picker", { "photosPermission": "Sheegra Admin uses your photos to add product images." }]
    ]
  }
}
