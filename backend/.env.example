# ---- Database ----
DATABASE_URL="postgresql://user:password@localhost:5432/sheegra"

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ---- JWT ----
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="30d"
ADMIN_JWT_EXPIRES_IN="12h"

# ---- OTP / SMS Provider ----
# Set OTP_PROVIDER to "msg91", "twilio", or "console" (console = dev only, prints OTP to server logs, never use in production)
OTP_PROVIDER="console"

# MSG91 (recommended for Indian numbers)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# Twilio (alternative / international)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# ---- Payments: Razorpay ----
# Get these from https://dashboard.razorpay.com after completing business KYC.
# Settlements to your bank account are configured in the Razorpay dashboard, not in code.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Email (order confirmations, optional) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sheegra <orders@yourdomain.com>"

# ---- Delivery ----
DELIVERY_FEE_FLAT="25"
FREE_DELIVERY_ABOVE="499"

# ---- Error monitoring (optional) ----
# Leave blank in development. Get a free DSN at https://sentry.io to be notified
# when something breaks in production instead of finding out from a customer.
SENTRY_DSN=""
