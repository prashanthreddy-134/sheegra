// Sheegra — shared database schema
// One database, consumed by:
// customer mobile app, customer website,
// admin mobile app, admin website

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  email     String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  orders        Order[]
  otps          OtpRequest[]
  notifications Notification[]
  pushTokens    PushToken[]

  storeCash             StoreCash?
  storeCashTransactions StoreCashTransaction[]
  couponUsages          CouponUsage[]
}

// ============================================================
// STORE CASH
// ============================================================

model StoreCash {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions StoreCashTransaction[]
}

enum StoreCashTransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

model StoreCashTransaction {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeCashId String
  storeCash   StoreCash @relation(fields: [storeCashId], references: [id], onDelete: Cascade)

  type StoreCashTransactionType

  amount        Decimal @db.Decimal(10, 2)
  balanceBefore Decimal @db.Decimal(10, 2)
  balanceAfter  Decimal @db.Decimal(10, 2)

  description String?

  orderId   String?
  reference String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([storeCashId])
  @@index([createdAt])
}

// ============================================================
// PUSH TOKENS
// ============================================================

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
}

// ============================================================
// OTP
// ============================================================

model OtpRequest {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  purpose   String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([phone, purpose])
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  imageUrl  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  unit        String

  mrp          Decimal  @db.Decimal(10, 2)
  sellingPrice Decimal  @db.Decimal(10, 2)
  discountPct  Decimal? @db.Decimal(5, 2)

  imageUrl String?
  images   String[] @default([])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  stockQty      Int @default(0)
  lowStockAlert Int @default(10)

  isActive Boolean @default(true)

  tags String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  wishlist   WishlistItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([name])
}

// ============================================================
// CART / WISHLIST
// ============================================================

model CartItem {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ============================================================
// ADDRESSES
// ============================================================

model Address {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  label    String
  line1    String
  line2    String?
  landmark String?
  city     String
  state    String
  pincode  String

  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  orders Order[]
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id String @id @default(uuid())

  code String @unique

  description String?

  // PERCENT or FLAT
  discountType String

  discountValue Decimal @db.Decimal(10, 2)

  minOrderValue Decimal? @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2)

  // Global usage limit
  usageLimit Int?
  usedCount  Int  @default(0)

  // ==========================================================
  // CUSTOMER USAGE RULE
  //
  // UNLIMITED
  // FIRST_ORDER
  // ONCE_EVER
  // ONCE_PER_MONTH
  // ==========================================================

  usageRule String @default("UNLIMITED")

  // ==========================================================
  // PAYMENT METHOD REQUIREMENT
  //
  // ANY
  // CARD
  // DEBIT_CARD
  // CREDIT_CARD
  // UPI
  // NETBANKING
  // ==========================================================

  paymentMethod String @default("ANY")

  isActive Boolean @default(true)

  validFrom DateTime  @default(now())
  validTill DateTime?

  orders Order[]

  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@index([validFrom])
  @@index([validTill])
}

// ============================================================
// COUPON USAGE
//
// This table records exactly which customer used which coupon.
//
// This allows:
//
// FIRST_ORDER
// ONCE_EVER
// ONCE_PER_MONTH
//
// Failed payments do NOT need to create a usage record.
// Usage should be created only after successful payment.
// ============================================================

model CouponUsage {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  usedAt DateTime @default(now())

  // Stored separately so monthly usage checks are simple
  usageYear  Int
  usageMonth Int

  @@unique([orderId])
  @@index([userId])
  @@index([couponId])
  @@index([userId, couponId])
  @@index([userId, couponId, usageYear, usageMonth])
}

// ============================================================
// ORDERS
// ============================================================

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  items OrderItem[]

  subtotal      Decimal @db.Decimal(10, 2)
  discount      Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee   Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  storeCashUsed Decimal @default(0) @db.Decimal(10, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  couponUsage CouponUsage?

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(CREATED)

  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  statusHistory OrderStatusEvent[]
}

// ============================================================
// ORDER ITEMS
// ============================================================

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name String
  unit String

  price Decimal @db.Decimal(10, 2)

  quantity Int
}

// ============================================================
// ORDER STATUS HISTORY
// ============================================================

model OrderStatusEvent {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  status OrderStatus

  note String?

  createdAt DateTime @default(now())

  changedBy String?
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  channel String

  title String
  body  String

  status String @default("SENT")

  createdAt DateTime @default(now())
}
